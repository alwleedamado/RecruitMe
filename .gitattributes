# Default behavior: treat files as text when possible and normalize line endings.
* text=auto

# Explicitly declare binary files to avoid unwanted conversions.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary

# Enforce LF for shell scripts and markdown files.
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
